            <datasource caption='Sheet1 (tableau_user_segmentation)' name='federated.0crpixk1ro3zxa1gh4pdp1g33bl9' />
          </datasources>
          <datasource-dependencies datasource='federated.0crpixk1ro3zxa1gh4pdp1g33bl9'>
            <column caption='Repeat Order Rate (%)' datatype='real' name='[Calculation_0342624041500676]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([is_repeat]) * 100' />
            </column>
            <column caption='Is Repeat' datatype='integer' name='[is_repeat]' role='measure' type='quantitative' />
            <column caption='User Id' datatype='string' name='[user_id]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_0342624041500676]' derivation='User' name='[usr:Calculation_0342624041500676:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1u6y8831bjmttk1e47xtg1s9hch2'>
            <column caption='Promo Segment' datatype='string' name='[Calculation_0342624041242627]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [promo_amount] &gt; 0 THEN &quot;Promo&quot; &#10;ELSE &quot;Non-promo&quot; &#10;END' />
            </column>
            <column aggregation='Sum' caption='Is First order' datatype='integer' name='[Calculation_0342624046686214]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [order_date] = { FIXED [user_id] : MIN([order_date]) } THEN 1 ELSE 0 END' />
