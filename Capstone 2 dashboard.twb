      <column caption='Return on ROI' datatype='real' name='[Calculation_0342624029421568]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_gmv]) / SUM([total_promo])' />
      </column>
      <column caption='Repeat Order Rate (%)' datatype='real' name='[Calculation_0342624041500676]' role='measure' type='quantitative'>
