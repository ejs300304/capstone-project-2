      <table>
        <view>
          <datasources>
            <datasource caption='Sheet1 (tableau_user_segmentation)' name='federated.0crpixk1ro3zxa1gh4pdp1g33bl9' />
          </datasources>
          <datasource-dependencies datasource='federated.0crpixk1ro3zxa1gh4pdp1g33bl9'>
            <column caption='Budget Waste' datatype='integer' name='[Calculation_0342624052047882]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [user_segment] = &quot;Discount Seekers (Churned)&quot; THEN [total_promo] ELSE 0 END)' />
            </column>
            <column caption='Waste %' datatype='real' name='[Calculation_0342624052166667]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_0342624052047882] / sum([total_promo])' />
            </column>
            <column caption='Total Promo' datatype='integer' name='[total_promo]' role='measure' type='quantitative' />
            <column caption='User Segment' datatype='string' name='[user_segment]' role='dimension' type='nominal' />
